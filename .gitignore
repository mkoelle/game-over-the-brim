# Godot: ignore only the .godot/ cache. *.import and *.uid files MUST be
# committed (they hold import settings and UIDs; without them every clone
# regenerates UIDs and scene references break). Godot 4.4+ VCS guidance.
.godot/

# Build output / signing secrets (never commit keystores)
/build/
*.keystore
*.jks

# GdUnit4 generated test reports
/reports/

# GdUnit4 session-recovery cache (test guids/line numbers, regenerated per run)
/addons/gdUnit4/GdUnitRunner.cfg

# Crash dumps from local export/CI reproduction
*.core

# Local `task check` scratch output
godot_check.log

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~
